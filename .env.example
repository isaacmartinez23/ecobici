# Copia este archivo a .env y ajusta los valores. NO subas .env a Git.
# Todas las variables son OPCIONALES: el proyecto funciona con los valores
# por defecto de config/settings.yaml.

# Ruta de la base DuckDB (por defecto: data/ecobici.duckdb)
ECOBICI_DUCKDB_PATH=data/ecobici.duckdb

# Zona horaria local
ECOBICI_TIMEZONE=America/Mexico_City

# Nivel de logging: DEBUG, INFO, WARNING, ERROR
ECOBICI_LOG_LEVEL=INFO

# --- Persistencia del colector GBFS en CI (opcional) ---
# Estrategia: "local" (solo filesystem del runner, efímero) | "artifact" | "s3"
GBFS_PERSIST_STRATEGY=local
# Si usas S3 (no requerido para la versión básica):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# GBFS_S3_BUCKET=
# GBFS_S3_PREFIX=ecobici/gbfs/
